+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#if defined(__linux__)
+#include <unistd.h>
+#endif
 
 #include "src/base/build_config.h"
 #include "src/base/macros.h"
@@ -370,7 +377,198 @@
 #undef SET_HIGH_WORD
