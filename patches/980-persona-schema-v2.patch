+  if (p.hw_tier >= 3 && p.screen_width < 1920)
+    c.Error("tier.screen_class", "tier " + S(p.hw_tier) + " with " + S(p.screen_width) + "x" +
+                                     S(p.screen_height));
+  const GpuFamily gf = FamilyOfGlString(p.webgl_vendor);
+  if (gf == GpuFamily::kNvidia || gf == GpuFamily::kAmd) {
+    if (p.hw_tier == 1)
