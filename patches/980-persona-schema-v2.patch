+// V8's heap sizing from physical memory (v8/src/heap/heap.cc), for the persona's form factor.
+uint64_t HeapLimitForPhysical(uint64_t physical, bool mobile) {
+  constexpr uint64_t kMiB = 1024ull * 1024ull;
+  constexpr uint64_t kGiB = 1024ull * kMiB;
+  constexpr uint64_t kPage = 256ull * 1024ull;  // v8 NormalPage::kPageSize
+  // Heap::OldGenerationSizeFromPhysicalMemory: kRatio 2 on 64-bit desktop, 4 on Android;
+  // clamped to [kDefaultMinHeapSize 256 MiB, kDefaultMaxHeapSize 4 GiB], page-rounded.
+  uint64_t old_gen = physical / (mobile ? 4ull : 2ull);
+  old_gen = std::min<uint64_t>(std::max<uint64_t>(old_gen, 256ull * kMiB), 4ull * kGiB);
+  old_gen = (old_gen + kPage - 1) / kPage * kPage;
+  // Heap::YoungGenerationSizeFromPhysicalMemory: semispace = (physical/4) / HeapSizeToSemiSpaceRatio,
+  // clamped to [2 MiB, DefaultMaxSemiSpaceSize]; Android below the 8 GB high-end threshold
+  // (physical / GB >= 8, integer division) uses ratio 128 and an 8 MiB cap, everything else
+  // ratio 32 and 32 MiB. Young = 2 semispaces + new large-object space (ratio 1).
+  const bool high_end = !mobile || (physical / kGiB) >= 8ull;
+  const uint64_t ratio = high_end ? 32ull : 128ull;
+  const uint64_t cap = high_end ? 32ull * kMiB : 8ull * kMiB;
+  uint64_t semi = (physical / 4) / ratio;
+  semi = std::min<uint64_t>(std::max<uint64_t>(semi, 2ull * kMiB), cap);
+  semi = (semi + kPage - 1) / kPage * kPage;
+  // HeapStatistics::heap_size_limit == Heap::MaxReserved().
+  return old_gen + 3ull * semi;
+}
+
+uint64_t NominalRamBytes(const PersonaProfile& p) {
+  constexpr uint64_t kGiB = 1024ull * 1024ull * 1024ull;
+  return static_cast<uint64_t>(p.device_memory_gb * static_cast<float>(kGiB));
+}
+
+}  // namespace
+
+uint64_t PersonaHeapLimitBytes(const PersonaProfile& p) {
+  constexpr uint64_t kMiB = 1024ull * 1024ull;
+  // Nominal RAM minus a hardware-reserved slice: 64 MiB + (seed-derived, < 256 MiB), 4 KiB grain.
+  const uint64_t nominal = NominalRamBytes(p);
+  const uint64_t reserved = (64ull * kMiB + ((p.persona_seed >> 20) % (256ull * kMiB))) & ~4095ull;
+  return HeapLimitForPhysical(nominal > reserved ? nominal - reserved : nominal, p.mobile);
+}
+
+void PersonaHeapLimitBounds(const PersonaProfile& p, uint64_t* lo, uint64_t* hi) {
+  constexpr uint64_t kGiB = 1024ull * 1024ull * 1024ull;
+  const uint64_t nominal = NominalRamBytes(p);
+  *hi = HeapLimitForPhysical(nominal, p.mobile);
+  *lo = HeapLimitForPhysical(nominal > kGiB ? nominal - kGiB : nominal / 2, p.mobile);
+}
