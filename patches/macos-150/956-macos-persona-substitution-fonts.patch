+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_MAC_PERSONA_FONT_REGISTRY_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_MAC_PERSONA_FONT_REGISTRY_H_
+
+#include "third_party/blink/renderer/platform/platform_export.h"
+
+namespace blink {
+
+// clearcote-956: register the bundled metric-compatible font clones with
+// CoreText, for this process only, so FontCache::MetricCompatibleSubstitute has
+// something to resolve to on a macOS host.
+//
+// These are the same files assets/fonts/ ships with the Linux release, where
+// the SDK points FONTCONFIG_FILE at fonts.conf.template to the same end. macOS
+// has no fontconfig, so the files travel inside the app bundle at
+// <Chromium Framework.framework>/Resources/clearcote_fonts/ and are registered
+// here instead. Same clones, same mapping, so one persona renders the same way
+// on the Linux and macOS artifacts.
+//
+// kCTFontManagerScopeProcess: visible to this process alone, never written to
+// the user's font database, and gone when the process exits. Idempotent and
+// thread-safe; the first call does the work, later calls take the lock and
+// return the stored result.
+PLATFORM_EXPORT bool EnsurePersonaSubstituteFontsRegistered();
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_MAC_PERSONA_FONT_REGISTRY_H_
