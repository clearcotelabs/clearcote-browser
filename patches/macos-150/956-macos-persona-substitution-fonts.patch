--- /dev/null
+++ b/third_party/blink/renderer/platform/fonts/mac/persona_font_registry.mm
@@ -0,0 +1,88 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/platform/fonts/mac/persona_font_registry.h"
+
+#import <CoreText/CoreText.h>
+
+#include <vector>
+
+#include "base/apple/bridging.h"
+#include "base/apple/bundle_locations.h"
+#include "base/apple/foundation_util.h"
+#include "base/apple/scoped_cftyperef.h"
+#include "base/files/file_enumerator.h"
+#include "base/files/file_path.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+
+namespace blink {
+
+namespace {
+
+// Where chrome/BUILD.gn's clearcote_persona_fonts bundle_data lands them.
+constexpr char kFontsSubdir[] = "clearcote_fonts";
+
+bool RegisterOnce() {
+  const base::FilePath dir =
+      base::apple::FrameworkBundlePath().Append("Resources").Append(
+          kFontsSubdir);
+
+  // Collect the files first: CTFontManagerRegisterFontsForURLs registers the
+  // whole array in one call, which is both faster than one call per file and
+  // the only form that reports per-file errors without aborting the rest.
+  std::vector<base::FilePath> files;
+  base::FileEnumerator e(dir, /*recursive=*/false,
+                         base::FileEnumerator::FILES);
+  for (base::FilePath p = e.Next(); !p.empty(); p = e.Next()) {
+    const std::string ext = p.Extension();
+    if (ext == ".ttf" || ext == ".otf" || ext == ".ttc") {
+      files.push_back(p);
+    }
+  }
+  if (files.empty()) {
+    LOG(ERROR) << "clearcote: no persona substitution fonts at "
+               << dir.value()
+               << " -- a cross-OS persona will report its fonts absent";
+    return false;
+  }
+
+  NSMutableArray<NSURL*>* urls =
+      [NSMutableArray arrayWithCapacity:files.size()];
+  for (const base::FilePath& p : files) {
+    [urls addObject:base::apple::FilePathToNSURL(p)];
+  }
+
+  base::apple::ScopedCFTypeRef<CFArrayRef> errors;
+  const bool ok = CTFontManagerRegisterFontsForURLs(
+      base::apple::NSToCFPtrCast(urls), kCTFontManagerScopeProcess,
+      errors.InitializeInto());
+  if (!ok) {
+    // Not fatal: CoreText registers every file it can and reports the rest.
+    // The commonest cause is a duplicate registration in a reused process.
+    LOG(WARNING) << "clearcote: CTFontManagerRegisterFontsForURLs reported "
+                 << (errors ? CFArrayGetCount(errors.get()) : 0)
+                 << " error(s) over " << files.size() << " font file(s)";
+  }
+  return ok;
+}
+
+}  // namespace
+
+bool EnsurePersonaSubstituteFontsRegistered() {
+  // Blink asks for fonts from the main thread and from worker threads, and the
+  // first substitution can come from either.
+  static base::NoDestructor<base::Lock> lock;
+  static bool done = false;
+  static bool result = false;
+  base::AutoLock auto_lock(*lock);
+  if (!done) {
+    result = RegisterOnce();
+    done = true;
+  }
+  return result;
+}
+
+}  // namespace blink
