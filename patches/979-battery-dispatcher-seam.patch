+#include "base/time/time.h"
+#include "components/ungoogled/persona_profile.h"
 #include "services/device/public/mojom/battery_status.mojom-blink.h"
 #include "third_party/blink/public/platform/browser_interface_broker_proxy.h"
 #include "third_party/blink/public/platform/platform.h"
@@ -11,6 +16,36 @@
 
 namespace blink {
 
+namespace {
+
+// clearcote: the battery state the persona machine reports, built through the
+// four-argument BatteryStatus ctor so |level| takes the same
+// EnsureTwoSignificantDigits() rounding a host reading takes (the default ctor
+// writes level_ directly and skips it).
+//
+// Desktop personas: a battery-less machine on AC -- the exact tuple real Chrome
+// reports there (charging, chargingTime 0, dischargingTime +Infinity, level 1).
+// Android persona: on battery, discharging; chargingTime +Infinity, a plausible
+// finite dischargingTime, and a seed-derived level in 0.55..0.98 rounded to
+// 0.01 -- the same values the 150 getters served, moved to the one place every
+// reader (getters, HasLastData(), the four *change events) copies from.
+BatteryStatus PersonaBatteryStatus() {
+  const ungoogled::PersonaProfile& p = ungoogled::CurrentPersona();
+  if (!p.mobile) {
+    return BatteryStatus(/*charging=*/true,
+                         /*charging_time=*/base::TimeDelta(),
+                         /*discharging_time=*/base::TimeDelta::Max(),
+                         /*level=*/1.0);
+  }
+  const uint64_t s = p.persona_seed;
+  return BatteryStatus(/*charging=*/false,
+                       /*charging_time=*/base::TimeDelta::Max(),
+                       /*discharging_time=*/base::Seconds(13680),
+                       /*level=*/(55 + static_cast<int>(s % 44)) / 100.0);
+}
+
+}  // namespace
+
 BatteryDispatcher::BatteryDispatcher(ExecutionContext* context)
     : monitor_(context), has_latest_data_(false) {}
 
@@ -30,9 +65,16 @@
 
   DCHECK(battery_status);
 
-  UpdateBatteryStatus(BatteryStatus(
-      battery_status->charging, base::Seconds(battery_status->charging_time),
-      base::Seconds(battery_status->discharging_time), battery_status->level));
+  // clearcote: the host's power state must never reach the page, neither as a
+  // value nor as an event. This is the ONE place the mojom status becomes the
+  // BatteryStatus every BatteryManager copies from LatestData(); publishing
+  // the persona status here keeps the getters, HasLastData() and the four
+  // *change events on one source, so DidUpdateData() compares the persona
+  // status with itself and dispatches nothing -- what real Chrome does on a
+  // machine whose power state does not change. The monitor pipe stays bound
+  // and re-armed above, so getBattery() resolves after the same IPC round
+  // trip as upstream. The host values are deliberately not read.
+  UpdateBatteryStatus(PersonaBatteryStatus());
 }
 
