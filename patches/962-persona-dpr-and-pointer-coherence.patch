 namespace blink {
 
 namespace {
 
+// clearcote(#11-follow-up): CSS image-set() picks its candidate from the ratio
+// handed to style resolution. That was document.DevicePixelRatio(), the frame's
+// REAL ratio, so a persona claiming 2x still resolved image-set() at 1x even
+// after srcset and (resolution: Ndppx) were corrected -- the same contradiction
+// in a third channel. Same resolver as window.devicePixelRatio and Sec-CH-DPR.
+float ClearcoteStyleDevicePixelRatio(const Document& document) {
+  const double persona_dpr = ungoogled::PersonaDevicePixelRatio();
+  if (persona_dpr > 0) {
+    return static_cast<float>(persona_dpr);
+  }
+  return document.DevicePixelRatio();
+}
