+gfx::Vector2d LocalDOMWindow::PersonaScreenOriginDelta() const {
+  // clearcote(#11-follow-up): only when the window origin is actually
+  // synthesised. With no override this returns (0,0) and every coordinate path
+  // behaves exactly as stock.
+  if (AvailOverrides().avail_width <= 0 && !PersonaWindowActive()) {
+    return gfx::Vector2d();
+  }
+  LocalFrame* frame = GetFrame();
+  if (!frame) {
+    return gfx::Vector2d();
+  }
+  Page* page = frame->GetPage();
+  if (!page) {
+    return gfx::Vector2d();
+  }
+  const gfx::Rect real = page->GetChromeClient().RootWindowRect(*frame);
+  return gfx::Vector2d(screenX() - real.x(), screenY() - real.y());
+}
