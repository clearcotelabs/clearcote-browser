 // clamping the persona at init, but robust across multiple contexts and
 // GPU-process restarts, and it costs exactly the one GetIntegerv that stock
 // Chrome already performs for this pname.
+// clearcote(#15): the capture's stencil masks, served ONLY while the context has not written
+// stencil state. These are mutable GL state (stencilFunc / stencilMask and the *Separate
+// variants write them), not capability limits -- so overriding them unconditionally would make
+// gl.stencilMask(x) followed by getParameter(STENCIL_WRITEMASK) disagree, a contradiction any
+// page can check with no reference data. 0 means the capture carried no value.
+int64_t ClearcoteStencilMask(GLenum pname) {
+  const ungoogled::PersonaProfile& p = ungoogled::CurrentPersona();
+  switch (pname) {
+    case GL_STENCIL_VALUE_MASK:
+      return p.webgl_stencil_value_mask;
+    case GL_STENCIL_WRITEMASK:
+      return p.webgl_stencil_writemask;
+    case GL_STENCIL_BACK_VALUE_MASK:
+      return p.webgl_stencil_back_value_mask;
+    case GL_STENCIL_BACK_WRITEMASK:
+      return p.webgl_stencil_back_writemask;
+    default:
+      return 0;
+  }
+}
