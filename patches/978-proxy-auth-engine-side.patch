   }
 
+  // clearcote: answer a PROXY challenge with the --proxy-auth identity, once.
+  //
+  // WHY HERE: at this point handler_ was built from the proxy's real
+  // Proxy-Authenticate header, so realm (Basic) and nonce/qop (Digest) are
+  // correct and GenerateAuthToken just works; the cache lookup above already
+  // missed, so nothing better is known for this realm. Returning true makes
+  // HaveAuth() true, so HttpNetworkTransaction::IsReadyToRestartForAuth()
+  // triggers the same silent restart the URL-embedded identity uses, and
+  // ResetAuth() then seeds the HttpAuthCache -- from the second request on
+  // SelectPreemptiveAuth() sends Proxy-Authorization up front, exactly as
+  // stock Chrome does after the user has answered the prompt once.
+  // Never for AUTH_SERVER: these are the proxy's credentials only.
+  if (target_ == HttpAuth::AUTH_PROXY && !proxy_switch_identity_used_ &&
+      GetProxySwitchCredentials().valid) {
+    identity_.source = HttpAuth::IDENT_SRC_EXTERNAL;
+    identity_.invalid = false;
+    identity_.credentials = GetProxySwitchCredentials().credentials;
+    proxy_switch_identity_used_ = true;
+    return true;
+  }
