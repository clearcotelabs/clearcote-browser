+}  // namespace
+
+std::vector<PersonaViolation> ValidatePersona(const PersonaProfile& p,
+                                              const PersonaValidationContext& ctx) {
+  Collector c;
+  const PersonaPlatform plat = EffectivePlatform(ctx.platform);
+#if !BUILDFLAG(IS_WIN)
+  if (ctx.platform == PersonaPlatform::kUnset) {
+    c.Warn("platform.unset_on_non_windows_host",
+           "no --fingerprint-platform: persona keeps Windows-shaped defaults on a non-Windows build");
+  }
+#endif
+  if (ctx.platform == PersonaPlatform::kMacOS) {
+    // DerivePersona() has no macOS block: a macos launch serves the Windows-shaped
+    // defaults (Direct3D renderer, SAPI voices, Realtek roster) under a Mac UA.
+    // Validated as Windows-shaped here, and said so, until that block exists.
+    c.Warn("platform.macos_not_modelled",
+           "macOS persona is the Windows-shaped default set; its own coherence rules are not modelled");
+  }
+  CheckScreen(p, plat, c);
+  CheckHardware(p, plat, c);
+  CheckTouchAndForm(p, plat, c);
+  CheckGpu(p, plat, c);
+  CheckWebGlLimits(p, plat, c);
+  CheckWebGpu(p, plat, c);
+  CheckMediaAndAudio(p, plat, c);
+  CheckVoicesAndDevices(p, plat, c);
+  CheckIdentity(p, ctx, c);
+  return c.Take();
+}
+
+bool HasPersonaErrors(const std::vector<PersonaViolation>& violations) {
+  for (const auto& v : violations) {
+    if (v.severity == Severity::kError)
+      return true;
+  }
+  return false;
+}
+
+std::string DescribePersona(uint64_t seed, PersonaPlatform platform, const PersonaProfile& p) {
+  std::string s = "seed=" + S(seed) + " platform=" +
+                  (PersonaPlatformName(platform)[0] ? PersonaPlatformName(platform) : "unset") +
+                  " persona_seed=" + S(p.persona_seed) +
+                  " version=" + p.chrome_full_version +
+                  " screen=" + S(p.screen_width) + "x" + S(p.screen_height) +
+                  " avail=" + S(p.avail_screen_width) + "x" + S(p.avail_screen_height) +
+                  " dpr=" + S(p.device_pixel_ratio) + " depth=" + S(p.color_depth) +
+                  " gamut=" + p.css_color_gamut +
+                  " hc=" + S(p.hardware_concurrency) + " mem=" + S(p.device_memory_gb) +
+                  " touch=" + S(p.max_touch_points) + " mobile=" + (p.mobile ? "1" : "0") +
+                  " gpu='" + p.webgl_vendor + "|" + p.webgl_renderer + "'" +
+                  " webgpu=" + p.webgpu_vendor + "/" + p.webgpu_architecture +
+                  " voices=" + S(static_cast<uint64_t>(p.voices.size())) +
+                  " devices=" + S(static_cast<uint64_t>(p.media_devices.size())) +
+                  " real_gpu=" + (p.webgl_real ? "1" : "0");
+  return s;
+}
+
+std::optional<int> MaybeRunPersonaValidationCli(const base::CommandLine& cmd,
+                                                const std::string& engine_version) {
+  if (!cmd.HasSwitch(kValidateSwitch))
+    return std::nullopt;
+  if (cmd.HasSwitch("type"))  // child process: not ours to answer
+    return std::nullopt;
+
+  PersonaValidationContext ctx;
+  ctx.platform = GetPersonaPlatform();
+  {
+    unsigned maj = 0;
+    if (base::StringToUint(engine_version.substr(0, engine_version.find('.')), &maj))
+      ctx.engine_major = maj;
+  }
+
+  const std::string spec = cmd.GetSwitchValueASCII(kValidateSwitch);
+  std::vector<uint64_t> seeds;
+  uint64_t n = 0;
+  if (spec == "current") {
+    seeds.push_back(cmd.HasSwitch(switches::kFingerprint)
+                        ? PersonaSeedFromString(cmd.GetSwitchValueASCII(switches::kFingerprint))
+                        : 0);
+  } else if (spec.find(',') == std::string::npos && base::StringToUint64(spec, &n)) {
+    if (n == 0 || n > 1000000) {
+      fprintf(stderr, "clearcote-validate-persona: N must be 1..1000000\n");
+      return 2;
+    }
+    for (uint64_t i = 1; i <= n; ++i)
+      seeds.push_back(i);
+  } else {
+    for (const std::string& tok :
+         base::SplitString(spec, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+      seeds.push_back(ParseSeedToken(tok));
+    }
+    if (seeds.empty()) {
+      fprintf(stderr, "clearcote-validate-persona: empty seed list\n");
+      return 2;
+    }
+  }
+
+  std::string report;
+  uint64_t errors = 0, warnings = 0, failing_seeds = 0;
+  for (uint64_t seed : seeds) {
+    const PersonaProfile p = DerivePersona(seed);
+    const std::vector<PersonaViolation> v = ValidatePersona(p, ctx);
+    bool seed_failed = false;
+    for (const PersonaViolation& viol : v) {
+      const bool err = viol.severity == Severity::kError;
+      errors += err ? 1 : 0;
+      warnings += err ? 0 : 1;
+      seed_failed = seed_failed || err;
+      report += std::string(err ? "ERROR" : "WARN") + " seed=" + S(seed) + " " + viol.invariant +
+                ": " + viol.detail + "\n";
+    }
+    // Always describe the persona for a small explicit set (a single-seed
+    // "current" run must be self-describing); for a sweep only on violations.
+    if (!v.empty() || seeds.size() <= 20)
+      report += "REPRO " + DescribePersona(seed, ctx.platform, p) + "\n";
+    if (seed_failed)
+      ++failing_seeds;
+  }
+  report += "SUMMARY seeds=" + S(static_cast<uint64_t>(seeds.size())) + " failing_seeds=" +
+            S(failing_seeds) + " errors=" + S(errors) + " warnings=" + S(warnings) +
+            " engine=" + engine_version + " platform=" +
+            (PersonaPlatformName(ctx.platform)[0] ? PersonaPlatformName(ctx.platform) : "unset") +
+            "\n";
+
+  if (cmd.HasSwitch(kValidateOutSwitch)) {
+    const base::FilePath out = cmd.GetSwitchValuePath(kValidateOutSwitch);
+    if (!base::WriteFile(out, report)) {
+      fprintf(stderr, "clearcote-validate-persona: cannot write report\n");
+      return 2;
+    }
+  } else {
+    fputs(report.c_str(), stdout);
+    fflush(stdout);
+  }
+  return errors == 0 ? 0 : 3;
+}
