+using Severity = PersonaViolation::Severity;
+
+constexpr char kValidateSwitch[] = "clearcote-validate-persona";
+constexpr char kValidateOutSwitch[] = "clearcote-validate-persona-out";
+
+class Collector {
+ public:
+  void Error(const char* invariant, std::string detail) {
+    out_.push_back({Severity::kError, invariant, std::move(detail)});
+  }
+  void Warn(const char* invariant, std::string detail) {
+    out_.push_back({Severity::kWarning, invariant, std::move(detail)});
+  }
+  std::vector<PersonaViolation> Take() { return std::move(out_); }
+
+ private:
+  std::vector<PersonaViolation> out_;
+};
