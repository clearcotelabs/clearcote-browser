+// clearcote: persona coherence validator.
+//
+// A PersonaProfile is one machine. Every browser-visible value derived from it
+// must agree with every other value derived from it, because a page can compare
+// them inside one load with no baseline and no population data. This validator
+// checks the RELATIONSHIPS between fields (screen vs work area, cores vs RAM,
+// GPU vendor vs renderer vs WebGPU adapter, platform vs backend vs voices, ...),
+// not fields in isolation. Every shipped coherence regression so far (r10
+// pointer:coarse on a desktop, r11 advertised-but-null extensions, the 151-port
+// version claim) was a relationship between two fields that were each fine on
+// their own.
+//
+// Two severities:
+//   kError   -- a contradiction real Chrome cannot produce. CI fails on these.
+//   kWarning -- suspicious, or dependent on a product decision that has not
+//               been taken (colour-depth buckets, heap-vs-RAM, WebGPU vs WebGL
+//               texture limits). Reported, never fatal.
+struct COMPONENT_EXPORT(UNGOOGLED) PersonaViolation {
+  enum class Severity { kError, kWarning };
+  Severity severity = Severity::kError;
+  // Stable identifier, "<area>.<rule>", e.g. "screen.avail_within_screen".
+  std::string invariant;
+  // The concrete values that contradicted each other.
+  std::string detail;
+};
+
+struct PersonaValidationContext {
+  // The --fingerprint-platform value the persona was derived under. kUnset
+  // means the switch was absent: DerivePersona() then leaves the Windows-shaped
+  // defaults in place regardless of host, so kUnset validates as Windows.
+  PersonaPlatform platform = PersonaPlatform::kUnset;
+  // Engine major (151 for this tree). 0 skips the engine-version check.
+  unsigned engine_major = 0;
+};
+
+// Runs every invariant and returns all violations (empty == coherent).
+COMPONENT_EXPORT(UNGOOGLED)
+std::vector<PersonaViolation> ValidatePersona(
+    const PersonaProfile& p,
+    const PersonaValidationContext& ctx);
+
+// True when |violations| contains at least one kError.
+COMPONENT_EXPORT(UNGOOGLED)
+bool HasPersonaErrors(const std::vector<PersonaViolation>& violations);
+
+// One-line, deterministic reproduction record: the seed and platform that
+// produce this persona plus the key fields, so a failure can be re-derived
+// exactly on any machine running the same binary.
+COMPONENT_EXPORT(UNGOOGLED)
+std::string DescribePersona(uint64_t seed,
+                            PersonaPlatform platform,
+                            const PersonaProfile& p);
+
+// Diagnostic entry point for CI, wired into the browser process's earliest
+// startup callback.
+//
+//   --clearcote-validate-persona=<N>          seeds 1..N
+//   --clearcote-validate-persona=<a,b,c>      explicit seeds (numeric, or any
+//                                             string hashed exactly as
+//                                             --fingerprint= would hash it)
+//   --clearcote-validate-persona=current      the seed on this command line
+//   --clearcote-validate-persona-out=<path>   write the report there instead
+//                                             of stdout (a Windows GUI process
+//                                             has no console to print to)
+//
+// The persona is derived under the SAME command line as a real launch, so
+// --fingerprint-platform, --fingerprint-profile and the GPU switches all apply:
+// the sweep validates the persona family this command line would actually
+// serve. Returns the process exit code when the switch is present (0 = no
+// errors, 3 = at least one error, 2 = bad arguments); std::nullopt when it is
+// absent or this is not the browser process.
+COMPONENT_EXPORT(UNGOOGLED)
+std::optional<int> MaybeRunPersonaValidationCli(const base::CommandLine& cmd,
+                                                const std::string& engine_version);
+
