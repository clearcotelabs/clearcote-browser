+// clearcote: portable profile encryption key (clearcote-browser#12).
+
+#ifndef COMPONENTS_UNGOOGLED_PORTABLE_KEY_PROVIDER_H_
+#define COMPONENTS_UNGOOGLED_PORTABLE_KEY_PROVIDER_H_
+
+#include <string>
+
+#include "base/component_export.h"
+#include "base/files/file_path.h"
+#include "components/os_crypt/async/browser/key_provider.h"
+
+namespace ungoogled {
+
+// Supplies the cookie/password encryption key from the PROFILE rather than from
+// the OS keystore, so the whole user data directory can be copied to another
+// machine and still decrypt.
+//
+// Two modes:
+//   * caller secret  -- the key is derived from a caller-supplied string and
+//                       NOTHING is written to disk. Preferred when the profile
+//                       is synced to shared storage.
+//   * key file       -- a random key is generated once and stored in the
+//                       profile directory. Convenient, but it means the cookie
+//                       database is effectively unencrypted at rest, which is
+//                       inherent to portability rather than a flaw in it.
+class COMPONENT_EXPORT(UNGOOGLED) PortableKeyProvider
+    : public os_crypt_async::KeyProvider {
+ public:
+  // Exactly one of `key_file` / `caller_secret` is used; `caller_secret` wins.
+  PortableKeyProvider(base::FilePath key_file, std::string caller_secret);
+  ~PortableKeyProvider() override;
+
+  PortableKeyProvider(const PortableKeyProvider&) = delete;
+  PortableKeyProvider& operator=(const PortableKeyProvider&) = delete;
+
+  void GetKey(KeyCallback callback) override;
+  bool UseForEncryption() override;
+
+ private:
+  const base::FilePath key_file_;
+  const std::string caller_secret_;
+};
+
+}  // namespace ungoogled
+
+#endif  // COMPONENTS_UNGOOGLED_PORTABLE_KEY_PROVIDER_H_
--- a/components/ungoogled/portable_key_provider.cc
+++ b/components/ungoogled/portable_key_provider.cc
@@ -0,0 +1,109 @@
+// clearcote: portable profile encryption key (clearcote-browser#12).
+
+#include "components/ungoogled/portable_key_provider.h"
+
+#include <utility>
+#include <vector>
+
+#include "base/base64.h"
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/task/thread_pool.h"
+#include "components/os_crypt/async/common/algorithm.mojom.h"
+#include "components/os_crypt/async/common/encryptor.h"
+#include "crypto/hkdf.h"
+#include "crypto/random.h"
+
+namespace ungoogled {
+
+namespace {
+
+using os_crypt_async::Encryptor;
+
+// Distinct from the platform providers' "v10" so portable data is never
+// mistaken for DPAPI/Keychain data, and vice versa.
+constexpr char kPortableKeyTag[] = "ccp";
+
+constexpr size_t kKeySize = 32;  // Encryptor::Key::kAES256GCMKeySize
+
+// Domain separation for the derived-key mode.
+constexpr char kHkdfSalt[] = "clearcote-portable-profile";
+constexpr char kHkdfInfo[] = "os_crypt key v1";
+
+std::vector<uint8_t> DeriveFromSecret(const std::string& secret) {
+  const std::string derived =
+      crypto::HkdfSha256(secret, kHkdfSalt, kHkdfInfo, kKeySize);
+  return std::vector<uint8_t>(derived.begin(), derived.end());
+}
+
+// Reads the key from `path`, generating and storing one on first use.
+// Runs on the thread pool: this touches the disk.
+std::vector<uint8_t> LoadOrCreateKeyFile(const base::FilePath& path) {
+  std::string encoded;
+  if (base::ReadFileToString(path, &encoded)) {
+    std::string decoded;
+    if (base::Base64Decode(encoded, &decoded) && decoded.size() == kKeySize) {
+      return std::vector<uint8_t>(decoded.begin(), decoded.end());
+    }
+    LOG(ERROR) << "clearcote: portable key at " << path
+               << " is unreadable; refusing to overwrite it, because doing so "
+                  "would silently discard every cookie it protects.";
+    return std::vector<uint8_t>();
+  }
+
+  std::vector<uint8_t> key(kKeySize);
+  crypto::RandBytes(key);
+  const std::string encoded_new = base::Base64Encode(key);
+  if (!base::WriteFile(path, encoded_new)) {
+    LOG(ERROR) << "clearcote: could not write portable key to " << path
+               << "; this profile will not be portable.";
+    return std::vector<uint8_t>();
+  }
+  return key;
+}
+
+void ReplyWithKey(os_crypt_async::KeyProvider::KeyCallback callback,
+                  std::vector<uint8_t> key_bytes) {
+  if (key_bytes.size() != kKeySize) {
+    // Temporary, not permanent: a permanent error invites callers to conclude
+    // the data is unrecoverable and drop it.
+    std::move(callback).Run(
+        kPortableKeyTag,
+        base::unexpected(
+            os_crypt_async::KeyProvider::KeyError::kTemporarilyUnavailable));
+    return;
+  }
+  Encryptor::Key key(key_bytes, os_crypt_async::mojom::Algorithm::kAES256GCM);
+  std::move(callback).Run(kPortableKeyTag, std::move(key));
+}
+
+}  // namespace
+
+PortableKeyProvider::PortableKeyProvider(base::FilePath key_file,
+                                         std::string caller_secret)
+    : key_file_(std::move(key_file)),
+      caller_secret_(std::move(caller_secret)) {}
+
+PortableKeyProvider::~PortableKeyProvider() = default;
+
+void PortableKeyProvider::GetKey(KeyCallback callback) {
+  // Derived mode touches no disk, so it can answer inline.
+  if (!caller_secret_.empty()) {
+    ReplyWithKey(std::move(callback), DeriveFromSecret(caller_secret_));
+    return;
+  }
+  // File mode reads (and possibly writes) the profile directory, which must not
+  // happen on the calling sequence.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(&LoadOrCreateKeyFile, key_file_),
+      base::BindOnce(&ReplyWithKey, std::move(callback)));
+}
+
+bool PortableKeyProvider::UseForEncryption() {
+  return true;
+}
+
+}  // namespace ungoogled
