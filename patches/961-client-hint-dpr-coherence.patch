+double PersonaDevicePixelRatio() {
+  // Resolved once per process: this is read on every devicePixelRatio access and
+  // HasSwitch() is a map lookup plus (on Windows) a lowercasing allocation.
+  static const double kDpr = [] {
+    const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    if (!cmd) {
+      return 0.0;
+    }
+    double flag_dpr = 0;
+    if (cmd->HasSwitch(switches::kFingerprintDevicePixelRatio) &&
+        base::StringToDouble(
+            cmd->GetSwitchValueASCII(switches::kFingerprintDevicePixelRatio),
+            &flag_dpr) &&
+        flag_dpr > 0) {
+      return flag_dpr;
+    }
+    // A seeded persona carries its own DPR; without --fingerprint there is none.
+    if (cmd->HasSwitch(switches::kFingerprint)) {
+      const double persona_dpr = CurrentPersona().device_pixel_ratio;
+      if (persona_dpr > 0) {
+        return persona_dpr;
+      }
+    }
+    return 0.0;
+  }();
+  return kDpr;
+}
+
