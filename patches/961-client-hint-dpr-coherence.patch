 float FrameFetchContext::GetDevicePixelRatio() const {
+  // clearcote(#11): this feeds the Sec-CH-DPR client hint. It read
+  // Document::DevicePixelRatio(), the frame's REAL ratio -- a different accessor
+  // from the LocalDOMWindow::devicePixelRatio getter the persona overrides. A
+  // page therefore saw the persona ratio in JS and the host's true ratio on the
+  // wire, contradicting itself in one load. Same resolver both channels use.
+  const double persona_dpr = ungoogled::PersonaDevicePixelRatio();
+  if (persona_dpr > 0) {
+    return static_cast<float>(persona_dpr);
+  }
   if (GetResourceFetcherProperties().IsDetached()) {
     return frozen_state_->device_pixel_ratio;
   }
