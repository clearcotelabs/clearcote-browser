+namespace
+{
+// clearcote: opt-in HLSL shader dialect for a Windows persona on a non-D3D host.
+//
+// WEBGL_debug_shaders.getTranslatedShaderSource() returns the ACTIVE backend's dump. A Windows
+// persona names a Direct3D11 renderer, but on Linux the Vulkan backend answers with SPIR-V
+// disassembly, so a page can read the renderer string and the dialect beside it and see they
+// disagree. ANGLE's HLSL backend is a source-to-source translator needing no D3D device, so the
+// shader is re-translated for THIS QUERY ONLY. Rendering is untouched -- the Vulkan backend still
+// compiles and draws, and a WebGL pixel readback is identical with this on and off.
+//
+// Off unless CLEARCOTE_SHADER_DIALECT=hlsl. An environment variable rather than a switch because
+// this is the GPU process, which does not receive the fingerprint switches, and ANGLE builds
+// standalone so it cannot use base::CommandLine.
+bool ClearcoteWantsHlsl()
+{
+    static const bool kWant = [] {
+        const char *v = std::getenv("CLEARCOTE_SHADER_DIALECT");
+        return v != nullptr && std::string(v) == "hlsl";
+    }();
+    return kWant;
+}
+
+// Returns empty on any failure; every caller then falls back to the backend's real debug info. A
+// failed spoof must never destroy the honest answer.
+std::string ClearcoteTranslateToHlsl(sh::GLenum type,
+                                     ShShaderSpec spec,
+                                     const ShBuiltInResources &resources,
+                                     const ShCompileOptions &options,
+                                     const std::string &source)
+{
+    if (source.empty() || !sh::Initialize())
+    {
+        return std::string();
+    }
+    ShHandle handle = sh::ConstructCompiler(type, spec, SH_HLSL_4_1_OUTPUT, &resources);
+    if (handle == nullptr)
+    {
+        return std::string();
+    }
+    const char *strings[1] = {source.c_str()};
+    std::string out;
+    if (sh::Compile(handle, strings, 1, options))
+    {
+        out = sh::GetObjectCode(handle);
+    }
+    sh::Destruct(handle);
+    return out;
+}
+}  // namespace
+
+// clearcote: the debug info to report, HLSL when opted in and the translation succeeded, otherwise
+// the backend's own. Both the length query and the buffer read go through here so they agree --
+// disagreeing would truncate the caller's read.
+// Returns BY VALUE: ShaderImpl::getDebugInfo() itself returns by value, so handing back a
+// reference to it would dangle. Callers bind the result to a const& and lifetime extension applies.
+std::string Shader::clearcoteDebugInfo(const Context *context)
+{
+    std::string real = mImplementation->getDebugInfo();
+    if (!ClearcoteWantsHlsl())
+    {
+        return real;
+    }
+    // Already HLSL means a real D3D backend; keep the honest translation. Makes this a strict
+    // no-op in the Windows build even with the variable set.
+    const ShShaderOutput output = context->getCompiler()->getShaderOutputType();
+    if (output == SH_HLSL_4_1_OUTPUT || output == SH_HLSL_3_0_OUTPUT)
+    {
+        return real;
+    }
+    if (!mClearcoteHlslDone)
+    {
+        mClearcoteHlslDone = true;
+
+        // Mirror the options Shader::compile builds, so the HLSL matches what a D3D backend would
+        // have produced for this same context rather than a bare translator default.
+        ShCompileOptions options = {};
+        options.objectCode       = true;
+        options.emulateGLDrawID  = true;
+        if (context->isWebGL() || context->isHardenedContext())
+        {
+            options.initGLPosition                          = true;
+            options.limitCallStackDepth                     = true;
+            options.limitExpressionComplexity               = true;
+            options.initSharedVariables                     = true;
+            options.rejectWebglShadersWithLargeVariables    = true;
+            options.rejectWebglShadersWithUndefinedBehavior = true;
+            // ShaderD3D adds this one for hardened contexts (ShaderD3D.cpp).
+            options.clampIndirectArrayBounds = true;
+        }
+        else
+        {
+            options.emulateGLBaseVertexBaseInstance = true;
+        }
+
+        const std::string hlsl = ClearcoteTranslateToHlsl(
+            ToGLenum(mState.getShaderType()), Compiler::SelectShaderSpec(context->getState()),
+            context->getCompiler()->getBuiltInResources(), options, mState.getSource());
+
+        // The envelope ShaderD3D puts around it, so the shape matches a real D3D report and not
+        // just the dialect (ShaderD3D.cpp: debugInfo accumulation, then getDebugInfo()).
+        if (!hlsl.empty())
+        {
+            mClearcoteHlsl = "// INITIAL HLSL BEGIN\n\n" + hlsl + "\n// INITIAL HLSL END\n\n\n" +
+                             std::string("\n// ") + GetShaderTypeString(mState.getShaderType()) +
+                             " SHADER END\n";
+        }
+    }
+    return mClearcoteHlsl.empty() ? real : mClearcoteHlsl;
+}
