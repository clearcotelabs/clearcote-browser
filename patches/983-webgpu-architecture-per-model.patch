+std::string WebGpuArchitectureForModel(const std::string& r) {
+  // Modal adapter.info.architecture per model class in real decontaminated Windows captures
+  // (file 72): GTX 750 maxwell; GTX 1070 pascal; GTX 1650/1660 + RTX 2060 turing; RTX 30xx
+  // ampere; RTX 40xx lovelace; RTX 50xx blackwell; Quadro K kepler; HD 520/530/620 + UHD 620/630
+  // gen-9; UHD 770 gen-12-lp (19/21); Iris Xe gen-12lp (6/9); Arc A gen-12hp; RX 580 gcn-4;
+  // RX 6700 rdna-2; RX 7xxx / Radeon 780 rdna-3; RX 9070 rdna-4.
+  auto has = [&r](const char* s) { return r.find(s) != std::string::npos; };
+  auto number_after = [&r](const char* prefix) -> int {
+    const size_t i = r.find(prefix);
+    if (i == std::string::npos) return -1;
+    size_t j = i + strlen(prefix);
+    int n = 0, digits = 0;
+    while (j < r.size() && r[j] >= '0' && r[j] <= '9' && digits < 4) { n = n * 10 + (r[j] - '0'); ++j; ++digits; }
+    return digits ? n : -1;
+  };
+  if (has("GeForce")) {
+    const int rtx = number_after("RTX "), gtx = number_after("GTX ");
+    if (rtx >= 5000) return "blackwell";
+    if (rtx >= 4000) return "lovelace";
+    if (rtx >= 3000) return "ampere";
+    if (rtx >= 2000) return "turing";
+    if (gtx >= 1600) return "turing";
+    if (gtx >= 1000) return "pascal";
+    if (gtx >= 700) return "maxwell";
+    return std::string();
+  }
+  if (has("Quadro K")) return "kepler";
+  if (has("UHD Graphics 7")) return "gen-12-lp";
+  if (has("UHD Graphics 6") || has("HD Graphics 5") || has("HD Graphics 6")) return "gen-9";
+  if (has("Iris(R) Xe") || has("Iris Xe")) return "gen-12lp";
+  if (has("Arc(TM) A")) return "gen-12hp";
+  if (has("Radeon RX ")) {
+    const int n = number_after("Radeon RX ");
+    if (n >= 9000) return "rdna-4";
+    if (n >= 7000) return "rdna-3";
+    if (n >= 6000) return "rdna-2";
+    if (n >= 5000) return "rdna-1";
+    if (n >= 400) return "gcn-4";
+    return std::string();
+  }
+  if (has("Radeon 780") || has("Radeon 760")) return "rdna-3";
+  return std::string();
+}
