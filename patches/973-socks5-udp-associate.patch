+
+class IOBuffer;
+class NetLog;
+class StreamSocket;
+
+// clearcote: a DatagramServerSocket that relays through a SOCKS5 proxy (RFC 1928 §7).
+//
+// WHY. Chromium's SOCKS5 support is TCP CONNECT only, so with a proxy configured WebRTC's UDP
+// either bypasses it or does not flow. This wraps a real datagram socket and adds the UDP
+// ASSOCIATE handshake plus the per-datagram header the proxy expects:
+//
+//     RSV(2) FRAG(1) ATYP(1) DST.ADDR(variable) DST.PORT(2) | payload
+//
+// It is a DECORATOR: every method that has nothing to do with relaying is forwarded verbatim to
+// the wrapped socket. Only Listen/SendTo/RecvFrom differ. Multicast is refused rather than
+// forwarded — a relayed socket cannot meaningfully join a group, and pretending otherwise would
+// fail later and further from the cause.
+//
+// THE AWKWARD PART. The association needs a network round-trip, but Listen() is synchronous — it
+// returns a bare int with no completion callback, so there is nowhere to await one. So Listen()
+// binds the local socket immediately and *starts* the handshake; datagrams handed to SendTo()
+// before it finishes are QUEUED and flushed when the relay endpoint arrives. Blocking the network
+// service's IO thread is not an option, and dropping those datagrams silently would surface as ICE
+// flakiness that is miserable to trace back to here.
+class NET_EXPORT SOCKS5UDPSocket : public DatagramServerSocket {
+ public:
+  // `inner` is the real datagram socket. `proxy` is the SOCKS5 endpoint; `username`/`password` are
+  // its RFC 1929 credentials, empty when it wants none. `control_socket` is an already-constructed,
+  // not-yet-connected TCP socket to the proxy — injected so tests can supply a mock.
+  SOCKS5UDPSocket(std::unique_ptr<DatagramServerSocket> inner,
+                  std::unique_ptr<StreamSocket> control_socket,
+                  const HostPortPair& proxy,
+                  const NetworkTrafficAnnotationTag& traffic_annotation);
+
+  SOCKS5UDPSocket(const SOCKS5UDPSocket&) = delete;
+  SOCKS5UDPSocket& operator=(const SOCKS5UDPSocket&) = delete;
+
+  ~SOCKS5UDPSocket() override;
+
+  // Bytes the SOCKS5 header adds to every datagram, by destination address family. Callers that
+  // care about the path MTU must subtract this: WebRTC sizes its packets, and silently exceeding
+  // the MTU presents as packet loss rather than as an error.
+  static constexpr int kHeaderOverheadIPv4 = 10;
+  static constexpr int kHeaderOverheadIPv6 = 22;
+
+  // True once the association is up and datagrams flow without queueing.
+  bool associated() const { return associated_; }
+
+  // DatagramServerSocket implementation.
+  int Listen(const IPEndPoint& address) override;
+  int RecvFrom(IOBuffer* buf,
+               int buf_len,
+               IPEndPoint* address,
+               CompletionOnceCallback callback) override;
+  int SendTo(IOBuffer* buf,
+             int buf_len,
+             const IPEndPoint& address,
+             CompletionOnceCallback callback) override;
+  int SetReceiveBufferSize(int32_t size) override;
+  int SetSendBufferSize(int32_t size) override;
+  void AllowAddressReuse() override;
+  void AllowBroadcast() override;
+  void AllowAddressSharingForMulticast() override;
+  int JoinGroup(const IPAddress& group_address) const override;
+  int LeaveGroup(const IPAddress& group_address) const override;
+  int SetMulticastInterface(uint32_t interface_index) override;
+  int SetMulticastTimeToLive(int time_to_live) override;
+  int SetMulticastLoopbackMode(bool loopback) override;
+  int SetDiffServCodePoint(DiffServCodePoint dscp) override;
+  void DetachFromThread() override;
+
+  // DatagramSocket implementation. These are TOS/fragmentation knobs on the real socket; they
+  // describe how OUR datagrams leave this machine, which is still meaningful when those datagrams
+  // happen to be carrying relayed payloads, so they delegate rather than being refused.
+  int SetDoNotFragment() override;
+  int SetRecvTos() override;
+  int SetTos(DiffServCodePoint dscp, EcnCodePoint ecn) override;
+  void SetMsgConfirm(bool confirm) override;
+  DscpAndEcn GetLastTos() const override;
+  void Close() override;
+  int GetPeerAddress(IPEndPoint* address) const override;
+  int GetLocalAddress(IPEndPoint* address) const override;
+  void UseNonBlockingIO() override;
+  const NetLogWithSource& NetLog() const override;
+
+ private:
+  // A datagram handed to SendTo() before the association was ready.
+  struct PendingSend {
+    PendingSend(scoped_refptr<IOBuffer> buf,
+                int buf_len,
+                const IPEndPoint& address,
+                CompletionOnceCallback callback);
+    PendingSend(PendingSend&&);
+    ~PendingSend();
+
+    scoped_refptr<IOBuffer> buf;
+    int buf_len;
+    IPEndPoint address;
+    CompletionOnceCallback callback;
+  };
+
+  // The association is two async steps. SOCKS5ClientSocket writes its greeting the moment
+  // Connect() is called, so the transport must already be connected when it is handed over --
+  // which is why the TCP connect happens first and the wrapper is built only afterwards.
+  void OnTransportConnected(int result);
+  void OnAssociateComplete(int result);
+  void FlushPending(int result);
+  // Frames `buf` for `address` and writes it to the relay. Returns a net error.
+  int SendFramed(IOBuffer* buf,
+                 int buf_len,
+                 const IPEndPoint& address,
+                 CompletionOnceCallback callback);
+  void OnRecvComplete(int result);
+  // Strips the header off a completed read and copies the payload into the caller's buffer.
+  // Returns the payload length, or a net error. Shared by the sync and async read paths so they
+  // cannot disagree about framing.
+  int StripInto(int result);
+
+  std::unique_ptr<DatagramServerSocket> inner_;
+  // Held unconnected until Listen(); moved into control_ once the TCP connect completes.
+  std::unique_ptr<StreamSocket> transport_;
+  std::unique_ptr<SOCKS5ClientSocket> control_;
+  const HostPortPair proxy_;
+  const NetworkTrafficAnnotationTag traffic_annotation_;
+
+  bool associated_ = false;
+  // Set once the handshake fails; every later operation reports it rather than hanging.
+  int association_error_ = OK;
+  IPEndPoint relay_;
+
+  std::vector<PendingSend> pending_;
+
+  // The caller's RecvFrom state, so the header can be stripped before handing bytes upward.
+  scoped_refptr<IOBuffer> recv_buf_;
+  int recv_buf_len_ = 0;
+  IPEndPoint* recv_address_ = nullptr;
+  CompletionOnceCallback recv_callback_;
+  scoped_refptr<IOBuffer> framed_recv_buf_;
+  // Where the inner socket reports the datagram came from: always the relay, never the true
+  // source, which is why it is read from the header instead and this value discarded.
+  IPEndPoint relay_seen_;
+
+  base::WeakPtrFactory<SOCKS5UDPSocket> weak_factory_{this};
+};
+
