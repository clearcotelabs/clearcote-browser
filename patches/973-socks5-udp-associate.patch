+# clearcote: standalone exercise of SOCKS5UDPSocket against a real proxy. Verifying the relay
+# through the browser needs WebRTC to allocate a P2P socket, which headless Chrome on a server
+# does not do -- so this drives the class directly instead. Small, incremental target.
+executable("socks5_udp_smoke") {
+  testonly = true
+  sources = [ "socket/socks5_udp_smoke.cc" ]
+  deps = [
+    ":net",
+    ":test_support",
+    "//base",
+  ]
+}
