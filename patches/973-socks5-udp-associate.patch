+int SOCKS5UDPSocket::GetLocalAddress(IPEndPoint* address) const {
+  // WebRTC builds host candidates from this. Once associated, the relay is where our traffic
+  // actually appears to come from, so that is the coherent answer; before that, defer to the real
+  // socket rather than inventing one.
+  if (associated_) {
+    *address = relay_;
+    return OK;
+  }
+  return inner_->GetLocalAddress(address);
+}
