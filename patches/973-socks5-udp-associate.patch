+// RFC 1928 section 7 address types.
+constexpr uint8_t kAtypIPv4 = 0x01;
+constexpr uint8_t kAtypIPv6 = 0x04;
+
+int HeaderSizeFor(const IPEndPoint& address) {
+  return address.address().IsIPv4() ? SOCKS5UDPSocket::kHeaderOverheadIPv4
+                                    : SOCKS5UDPSocket::kHeaderOverheadIPv6;
+}
+
+// Writes RSV(2) FRAG(1) ATYP(1) DST.ADDR DST.PORT into `out`, returning bytes written.
+// FRAG is always 0: reassembly is implemented essentially nowhere, and claiming a capability we do
+// not have would be worse than declining it.
+size_t WriteHeader(const IPEndPoint& address, base::span<uint8_t> out) {
+  const base::span<const uint8_t> addr_bytes = address.address().bytes();
+  out[0] = 0x00;
+  out[1] = 0x00;
+  out[2] = 0x00;  // FRAG
+  out[3] = address.address().IsIPv4() ? kAtypIPv4 : kAtypIPv6;
+  out.subspan(4u, addr_bytes.size()).copy_from(addr_bytes);
+  const size_t port_off = 4u + addr_bytes.size();
+  out[port_off] = static_cast<uint8_t>(address.port() >> 8);
+  out[port_off + 1u] = static_cast<uint8_t>(address.port() & 0xff);
+  return port_off + 2u;
+}
+
+// Parses the header off a received datagram. Returns the payload offset, or 0 when the datagram is
+// unusable: malformed, an address type a relay never sends, or fragmented (which is dropped rather
+// than reassembled).
+size_t ParseHeader(base::span<const uint8_t> pkt, IPEndPoint* source) {
+  if (pkt.size() < 10u || pkt[0] != 0x00 || pkt[1] != 0x00) {
+    return 0u;
+  }
+  if (pkt[2] != 0x00) {
+    return 0u;  // FRAG
+  }
+  size_t addr_len;
+  if (pkt[3] == kAtypIPv4) {
+    addr_len = 4u;
+  } else if (pkt[3] == kAtypIPv6) {
+    addr_len = 16u;
+  } else {
+    return 0u;
+  }
+  const size_t port_off = 4u + addr_len;
+  if (pkt.size() < port_off + 2u) {
+    return 0u;
+  }
+  const IPAddress address(pkt.subspan(4u, addr_len));
+  const uint16_t port =
+      static_cast<uint16_t>((pkt[port_off] << 8) | pkt[port_off + 1u]);
+  *source = IPEndPoint(address, port);
+  return port_off + 2u;
+}
+
+}  // namespace
+
+SOCKS5UDPSocket::PendingSend::PendingSend(scoped_refptr<IOBuffer> buf,
+                                          int buf_len,
+                                          const IPEndPoint& address,
+                                          CompletionOnceCallback callback)
+    : buf(std::move(buf)),
+      buf_len(buf_len),
+      address(address),
+      callback(std::move(callback)) {}
+SOCKS5UDPSocket::PendingSend::PendingSend(PendingSend&&) = default;
+SOCKS5UDPSocket::PendingSend::~PendingSend() = default;
+
+SOCKS5UDPSocket::SOCKS5UDPSocket(
+    std::unique_ptr<DatagramServerSocket> inner,
+    std::unique_ptr<StreamSocket> control_socket,
+    const HostPortPair& proxy,
+    const NetworkTrafficAnnotationTag& traffic_annotation)
+    : inner_(std::move(inner)),
+      transport_(std::move(control_socket)),
+      proxy_(proxy),
+      traffic_annotation_(traffic_annotation) {}
+
+SOCKS5UDPSocket::~SOCKS5UDPSocket() = default;
+
+int SOCKS5UDPSocket::Listen(const IPEndPoint& address) {
+  const int rv = inner_->Listen(address);
+  if (rv != OK) {
+    return rv;
+  }
+  // Start the association but do not wait on it: Listen() has no completion callback to hand a
+  // pending result to. Datagrams sent before it completes are queued in SendTo().
+  if (!transport_) {
+    association_error_ = ERR_UNEXPECTED;
+    return OK;
+  }
+  const int connect_rv = transport_->Connect(base::BindOnce(
+      &SOCKS5UDPSocket::OnTransportConnected, weak_factory_.GetWeakPtr()));
+  if (connect_rv != ERR_IO_PENDING) {
+    OnTransportConnected(connect_rv);
+  }
+  return OK;
+}
+
+void SOCKS5UDPSocket::OnTransportConnected(int result) {
+  if (result != OK) {
+    association_error_ = result;
+    FlushPending(result);
+    return;
+  }
+  // Only now is it safe to wrap: SOCKS5ClientSocket writes its greeting inside Connect().
+  control_ = std::make_unique<SOCKS5ClientSocket>(
+      std::move(transport_), proxy_, traffic_annotation_,
+      SOCKS5ClientSocket::kUdpAssociateCommand);
+  const int rv = control_->Connect(base::BindOnce(
+      &SOCKS5UDPSocket::OnAssociateComplete, weak_factory_.GetWeakPtr()));
+  if (rv != ERR_IO_PENDING) {
+    OnAssociateComplete(rv);
+  }
+}
+
+void SOCKS5UDPSocket::OnAssociateComplete(int result) {
+  if (result == OK) {
+    relay_ = control_->bound_endpoint();
+    // An unspecified BND.ADDR means "reuse the address you connected to". Without this the relay
+    // would be addressed as 0.0.0.0 and every datagram would go nowhere, silently.
+    if (relay_.address().IsZero()) {
+      IPEndPoint peer;
+      if (relay_.port() != 0 && control_->GetPeerAddress(&peer) == OK) {
+        relay_ = IPEndPoint(peer.address(), relay_.port());
+      } else {
+        result = ERR_SOCKS_CONNECTION_FAILED;
+      }
+    } else if (relay_.port() == 0) {
+      result = ERR_SOCKS_CONNECTION_FAILED;
+    }
+  }
+  if (result == OK) {
+    associated_ = true;
+  } else {
+    association_error_ = result;
+  }
+  FlushPending(result);
+}
+
+void SOCKS5UDPSocket::FlushPending(int result) {
+  std::vector<PendingSend> pending = std::move(pending_);
+  pending_.clear();
+  for (PendingSend& p : pending) {
+    if (result != OK) {
+      std::move(p.callback).Run(result);
+      continue;
+    }
+    // Every queued send already returned ERR_IO_PENDING to its caller, so each is owed exactly
+    // one callback -- whether the retry completes asynchronously or inline. Split it: one half
+    // rides into the async binding, the other runs here on a synchronous completion.
+    auto split = base::SplitOnceCallback(std::move(p.callback));
+    const int rv = SendFramed(p.buf.get(), p.buf_len, p.address,
+                              std::move(split.first));
+    if (rv != ERR_IO_PENDING) {
+      std::move(split.second).Run(rv);
+    }
+  }
+}
+
+int SOCKS5UDPSocket::SendFramed(IOBuffer* buf,
+                                int buf_len,
+                                const IPEndPoint& address,
+                                CompletionOnceCallback callback) {
+  const int header_size = HeaderSizeFor(address);
+  auto framed = base::MakeRefCounted<IOBufferWithSize>(header_size + buf_len);
+  const size_t written = WriteHeader(address, framed->span());
+  DCHECK_EQ(written, static_cast<size_t>(header_size));
+  framed->span().subspan(written).copy_prefix_from(
+      buf->span().first(static_cast<size_t>(buf_len)));
+
+  // The caller is owed the length IT asked to send, not our framed length, so success is
+  // translated back. `framed` rides along in the binding to stay alive for the async write.
+  auto on_done = base::BindOnce(
+      [](scoped_refptr<IOBuffer> keep_alive, int payload_len,
+         CompletionOnceCallback cb, int rv) {
+        if (cb) {
+          std::move(cb).Run(rv < 0 ? rv : payload_len);
+        }
+      },
+      framed, buf_len, std::move(callback));
+
+  const int rv = inner_->SendTo(framed.get(), header_size + buf_len, relay_,
+                                std::move(on_done));
+  if (rv == ERR_IO_PENDING) {
+    return rv;
+  }
+  return rv < 0 ? rv : buf_len;
+}
+
+int SOCKS5UDPSocket::SendTo(IOBuffer* buf,
+                            int buf_len,
+                            const IPEndPoint& address,
+                            CompletionOnceCallback callback) {
+  if (association_error_ != OK) {
+    return association_error_;
+  }
+  if (!associated_) {
+    // Queue rather than drop. Silent early loss is indistinguishable from a flaky network and is
+    // miserable to trace back to this layer.
+    pending_.emplace_back(scoped_refptr<IOBuffer>(buf), buf_len, address,
+                          std::move(callback));
+    return ERR_IO_PENDING;
+  }
+  return SendFramed(buf, buf_len, address, std::move(callback));
+}
+
+int SOCKS5UDPSocket::RecvFrom(IOBuffer* buf,
+                              int buf_len,
+                              IPEndPoint* address,
+                              CompletionOnceCallback callback) {
+  if (association_error_ != OK) {
+    return association_error_;
+  }
+  recv_buf_ = buf;
+  recv_buf_len_ = buf_len;
+  recv_address_ = address;
+  recv_callback_ = std::move(callback);
+  // Room for the caller's payload plus the largest header we might have to strip.
+  framed_recv_buf_ =
+      base::MakeRefCounted<IOBufferWithSize>(buf_len + kHeaderOverheadIPv6);
+
+  const int rv = inner_->RecvFrom(
+      framed_recv_buf_.get(), framed_recv_buf_->size(), &relay_seen_,
+      base::BindOnce(&SOCKS5UDPSocket::OnRecvComplete,
+                     weak_factory_.GetWeakPtr()));
+  if (rv == ERR_IO_PENDING) {
+    return rv;
+  }
+  // Synchronous completion: strip inline and report directly, without running the callback.
+  recv_callback_.Reset();
+  return StripInto(rv);
+}
+
+int SOCKS5UDPSocket::StripInto(int result) {
+  if (result <= 0) {
+    return result;
+  }
+  IPEndPoint source;
+  const size_t offset = ParseHeader(
+      framed_recv_buf_->span().first(static_cast<size_t>(result)), &source);
+  if (offset == 0u) {
+    // Malformed or fragmented. Report a failure rather than handing the layer above a datagram
+    // whose framing we did not understand.
+    return ERR_FAILED;
+  }
+  const size_t payload_len = static_cast<size_t>(result) - offset;
+  if (payload_len > static_cast<size_t>(recv_buf_len_)) {
+    return ERR_MSG_TOO_BIG;
+  }
+  recv_buf_->span().copy_prefix_from(
+      framed_recv_buf_->span().subspan(offset, payload_len));
+  // Report the ORIGINAL source rather than the relay: the layer above is running ICE and needs to
+  // know who actually sent this.
+  if (recv_address_) {
+    *recv_address_ = source;
+  }
+  return static_cast<int>(payload_len);
+}
+
+void SOCKS5UDPSocket::OnRecvComplete(int result) {
+  if (!recv_callback_) {
+    return;
+  }
+  std::move(recv_callback_).Run(StripInto(result));
+}
