+// found in the LICENSE file.
+//
+// clearcote: a standalone exercise of net::SOCKS5UDPSocket against a real SOCKS5 proxy.
+//
+// WHY THIS EXISTS. Verifying the relay through the browser requires WebRTC to allocate a P2P
+// socket, and headless Chrome on a server allocates none -- so the code under test never runs and
+// the "passing" browser tests prove only that the process starts. This drives the class directly:
+// no WebRTC, no ICE, no renderer. It links libnet.a and is a genuinely incremental target.
+//
+// Every check is paired with a control that must behave DIFFERENTLY. Run it against:
+//   - a UDP-capable proxy (expect success)
+//   - the same proxy with a wrong password (expect auth failure)
+//   - a proxy that refuses ASSOCIATE (expect a clean refusal, not a hang)
+
+#include <memory>
+#include <string>
+
+#include "base/at_exit.h"
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/message_loop/message_pump_type.h"
+#include "base/run_loop.h"
+#include "base/task/single_thread_task_executor.h"
+#include "base/time/time.h"
+#include "net/base/address_list.h"
+#include "net/base/host_port_pair.h"
+#include "net/base/io_buffer.h"
+#include "net/base/ip_address.h"
+#include "net/base/ip_endpoint.h"
+#include "net/base/net_errors.h"
+#include "net/base/test_completion_callback.h"
+#include "net/log/net_log_source.h"
+#include "net/socket/socks5_udp_socket.h"
+#include "net/socket/tcp_client_socket.h"
+#include "net/socket/udp_server_socket.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+
+namespace {
+
+int g_passed = 0;
+int g_failed = 0;
+
+void Report(const std::string& name, bool ok, const std::string& detail) {
+  if (ok) {
+    ++g_passed;
+    printf("  PASS  %s\n", name.c_str());
+  } else {
+    ++g_failed;
+    printf("  FAIL  %s\n            %s\n", name.c_str(), detail.c_str());
+  }
+  fflush(stdout);
+}
+
+net::IPEndPoint MakeEndPoint(const std::string& ip, uint16_t port) {
+  net::IPAddress address;
+  CHECK(address.AssignFromIPLiteral(ip)) << "bad literal: " << ip;
+  return net::IPEndPoint(address, port);
+}
+
+constexpr net::NetworkTrafficAnnotationTag kAnnotation =
+    net::DefineNetworkTrafficAnnotation("clearcote_socks5_udp_smoke", R"(
+        semantics {
+          sender: "Clearcote SOCKS5 UDP smoke test"
+          description: "Developer tool that opens a UDP association through a SOCKS5 proxy."
+          trigger: "Run manually by a developer."
+          data: "A short test payload."
+          destination: OTHER
+          destination_other: "A SOCKS5 proxy chosen on the command line."
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "Not user visible; a developer tool."
+          policy_exception_justification: "Not shipped to users."
+        })");
+
+std::unique_ptr<net::SOCKS5UDPSocket> MakeSocket(const net::IPEndPoint& proxy) {
+  auto inner = std::make_unique<net::UDPServerSocket>(nullptr, net::NetLogSource());
+  auto control = std::make_unique<net::TCPClientSocket>(
+      net::AddressList(proxy), nullptr, nullptr, nullptr, net::NetLogSource(),
+      net::handles::kInvalidNetworkHandle);
+  return std::make_unique<net::SOCKS5UDPSocket>(
+      std::move(inner), std::move(control),
+      net::HostPortPair::FromIPEndPoint(proxy), kAnnotation);
+}
+
+// Pumps the message loop until `predicate` holds or the deadline passes.
+bool PumpUntil(base::RepeatingCallback<bool()> predicate, base::TimeDelta limit) {
+  const base::TimeTicks deadline = base::TimeTicks::Now() + limit;
+  while (base::TimeTicks::Now() < deadline) {
+    if (predicate.Run()) {
+      return true;
+    }
+    base::RunLoop loop(base::RunLoop::Type::kNestableTasksAllowed);
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, loop.QuitClosure(), base::Milliseconds(50));
+    loop.Run();
+  }
+  return predicate.Run();
+}
+
+// Round-trips a datagram through the relay to `echo`. Returns a net error, or the payload length.
+int RoundTrip(const net::IPEndPoint& proxy, const net::IPEndPoint& echo, std::string* got) {
+  std::unique_ptr<net::SOCKS5UDPSocket> sock = MakeSocket(proxy);
+  const int listen_rv = sock->Listen(MakeEndPoint("127.0.0.1", 0));
+  if (listen_rv != net::OK) {
+    return listen_rv;
+  }
+
+  const std::string payload = "clearcote-udp-smoke";
+  auto out = base::MakeRefCounted<net::IOBufferWithSize>(payload.size());
+  out->span().copy_from(base::as_byte_span(payload));
+
+  net::TestCompletionCallback send_cb;
+  int rv = sock->SendTo(out.get(), static_cast<int>(payload.size()), echo,
+                        send_cb.callback());
+  rv = send_cb.GetResult(rv);
+  if (rv < 0) {
+    return rv;
+  }
+
+  auto in = base::MakeRefCounted<net::IOBufferWithSize>(4096);
+  net::IPEndPoint from;
+  net::TestCompletionCallback recv_cb;
+  int got_rv = sock->RecvFrom(in.get(), in->size(), &from, recv_cb.callback());
+  got_rv = recv_cb.GetResult(got_rv);
+  if (got_rv > 0) {
+    *got = std::string(reinterpret_cast<const char*>(in->span().data()),
+                       static_cast<size_t>(got_rv));
+  }
+  return got_rv;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  base::AtExitManager exit_manager;
+  base::CommandLine::Init(argc, argv);
+  base::SingleThreadTaskExecutor io_task_executor(base::MessagePumpType::IO);
+
+  const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  const std::string proxy_ip = cmd->GetSwitchValueASCII("proxy-ip");
+  const std::string proxy_port = cmd->GetSwitchValueASCII("proxy-port");
+  const std::string echo_port = cmd->GetSwitchValueASCII("echo-port");
+  if (proxy_ip.empty() || proxy_port.empty() || echo_port.empty()) {
+    fprintf(stderr,
+            "usage: socks5_udp_smoke --proxy-ip=IP --proxy-port=N --echo-port=N\n"
+            "                       [--socks5-credentials=user:pass] [--expect-fail]\n");
+    return 2;
+  }
+  const net::IPEndPoint proxy =
+      MakeEndPoint(proxy_ip, static_cast<uint16_t>(atoi(proxy_port.c_str())));
+  const net::IPEndPoint echo =
+      MakeEndPoint("127.0.0.1", static_cast<uint16_t>(atoi(echo_port.c_str())));
+  const bool expect_fail = cmd->HasSwitch("expect-fail");
+
+  printf("proxy=%s echo=%s expect_fail=%d\n", proxy.ToString().c_str(),
+         echo.ToString().c_str(), expect_fail ? 1 : 0);
+  fflush(stdout);
+
+  std::string got;
+  const int rv = RoundTrip(proxy, echo, &got);
+
+  if (expect_fail) {
+    Report("a refused or unauthenticated association fails cleanly",
+           rv < 0, "expected a negative net error, got " + std::to_string(rv) +
+                       " payload='" + got + "'");
+  } else {
+    Report("the association succeeds and a datagram round-trips",
+           rv > 0 && got.find("clearcote-udp-smoke") != std::string::npos,
+           "rv=" + std::to_string(rv) +
+               (rv < 0 ? " (" + net::ErrorToShortString(rv) + ")" : "") +
+               " payload='" + got + "'");
+  }
+
+  printf("\n%d passed, %d failed\n", g_passed, g_failed);
+  return g_failed ? 1 : 0;
+}
