+// clearcote: the SOCKS5 proxy to relay UDP through, or nullopt when the feature is off, no proxy
+// is configured, or the proxy is not one we can relay through.
+//
+// Resolved ONCE into a function-local static: this runs for every P2P socket, and HasSwitch() is a
+// map lookup plus, on Windows, a lowercasing allocation.
+//
+// Only an IP-literal proxy is handled today. A hostname would need an async resolve before the
+// control connection can be opened, and the factory is synchronous with nowhere to await one. We
+// decline rather than resolve on this thread, so the socket falls back to a direct one. Named
+// proxies are a follow-up, not a silent partial behaviour.
+const std::optional<net::IPEndPoint>& Socks5UdpRelayTarget() {
+  static const std::optional<net::IPEndPoint> target = [] {
+    std::optional<net::IPEndPoint> none;
+    const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    if (!cmd || !cmd->HasSwitch("socks5-udp") ||
+        !cmd->HasSwitch("proxy-server")) {
+      return none;
+    }
+    std::string spec = cmd->GetSwitchValueASCII("proxy-server");
+    const std::string kScheme = "socks5://";
+    if (spec.rfind(kScheme, 0) != 0) {
+      return none;
+    }
+    spec = spec.substr(kScheme.size());
+    const size_t colon = spec.rfind(':');
+    if (colon == std::string::npos) {
+      return none;
+    }
+    int port = 0;
+    if (!base::StringToInt(spec.substr(colon + 1), &port) || port <= 0 ||
+        port > 65535) {
+      return none;
+    }
+    net::IPAddress address;
+    if (!address.AssignFromIPLiteral(spec.substr(0, colon))) {
+      return none;  // A hostname: see above.
+    }
+    return std::make_optional(
+        net::IPEndPoint(address, static_cast<uint16_t>(port)));
+  }();
+  return target;
+}
