+// clearcote: pull BND.ADDR/BND.PORT out of the completed reply.
+//   VER(1) REP(1) RSV(1) ATYP(1) BND.ADDR(variable) BND.PORT(2)
+// Best-effort by design: a malformed tail must not fail a handshake the proxy already accepted, and
+// a caller that needs the endpoint checks whether it is empty. A DOMAIN reply is left empty rather
+// than half-resolved -- no proxy answers UDP ASSOCIATE with a name, and guessing would be worse
+// than saying nothing.
+void SOCKS5ClientSocket::ParseBoundEndpoint() {
+  bound_endpoint_ = IPEndPoint();
+  if (!read_buf_) {
+    return;
+  }
+  base::span<const uint8_t> buf = read_buf_->everything();
+  // VER REP RSV ATYP is 4 bytes, plus at least a 2-byte port.
+  if (buf.size() < 8u) {
+    return;
+  }
+  constexpr size_t kAddrOffset = 4u;
+  size_t addr_len;
+  if (buf[3] == kEndPointResolvedIPv4) {
+    addr_len = 4u;
+  } else if (buf[3] == kEndPointResolvedIPv6) {
+    addr_len = 16u;
+  } else {
+    return;  // DOMAIN, or something we do not understand.
+  }
+  if (buf.size() < kAddrOffset + addr_len + 2u) {
+    return;
+  }
+  const IPAddress address(buf.subspan(kAddrOffset, addr_len));
+  const uint16_t port = static_cast<uint16_t>((buf[kAddrOffset + addr_len] << 8) |
+                                              buf[kAddrOffset + addr_len + 1u]);
+  bound_endpoint_ = IPEndPoint(address, port);
+}
