 namespace {
 
+// clearcote: when a seeded persona is active, screen.width/height and
+// screen.availWidth/availHeight are the persona's (frame/screen.cc, gated on
+// --fingerprint exactly as here), but the OS window was still sized from the
+// REAL display's work area. A persona whose work area is smaller than the
+// display then reported a viewport larger than its own screen -- r17/r18, seed
+// verify-2026-09-02-A: avail 1536x824, inner 1689x1187 on both platforms. A
+// window cannot be larger than the screen it says it is on; that is one
+// comparison for a page, no baseline needed.
+//
+// This is the only place default bounds and bounds clamping read the work
+// area, so sizing against the persona work area here makes every window the
+// sizer produces satisfy inner <= outer <= avail <= screen. The persona rect is
+// intersected with the real display so the window is never larger than what
+// the host can actually show (a 3840x2160 persona on a 1920x1080 display).
+bool PersonaScreenActive() {
+  static const bool kActive = [] {
+    const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    return cmd && cmd->HasSwitch(switches::kFingerprint);
+  }();
+  return kActive;
+}
+
+// The work area screen.availWidth/availHeight report: an explicit
+// --fingerprint-avail-* switch first, then the persona -- the same resolution
+// order frame/screen.cc uses, so the window and the page's screen object are
+// sized from one value. 0x0 when neither applies.
+gfx::Size PersonaAvailSize() {
+  static const gfx::Size kSize = [] {
+    const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    int w = 0, h = 0;
+    if (cmd) {
+      if (cmd->HasSwitch(switches::kFingerprintAvailWidth))
+        base::StringToInt(cmd->GetSwitchValueASCII(switches::kFingerprintAvailWidth), &w);
+      if (cmd->HasSwitch(switches::kFingerprintAvailHeight))
+        base::StringToInt(cmd->GetSwitchValueASCII(switches::kFingerprintAvailHeight), &h);
+    }
+    const ungoogled::PersonaProfile& persona = ungoogled::CurrentPersona();
+    if (w <= 0)
+      w = persona.avail_screen_width;
+    if (h <= 0)
+      h = persona.avail_screen_height;
+    return gfx::Size(std::max(w, 0), std::max(h, 0));
+  }();
+  return kSize;
+}
+
+gfx::Rect EffectiveWorkArea(const gfx::Rect& display_work_area) {
+  if (!PersonaScreenActive())
+    return display_work_area;
+  const gfx::Size avail = PersonaAvailSize();
+  if (avail.IsEmpty())
+    return display_work_area;
+  gfx::Rect persona_area(display_work_area.origin(), avail);
+  persona_area.Intersect(display_work_area);
+  return persona_area.IsEmpty() ? display_work_area : persona_area;
+}
