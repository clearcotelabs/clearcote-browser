+// static
+void WindowSizer::ClampToPersonaWorkArea(gfx::Rect* bounds,
+                                         ui::mojom::WindowShowState* show_state) {
+  if (!bounds || !show_state || !PersonaScreenActive())
+    return;
+  display::Screen* screen = display::Screen::Get();
+  if (!screen)
+    return;
+  const display::Display display = bounds->IsEmpty()
+                                       ? screen->GetPrimaryDisplay()
+                                       : screen->GetDisplayMatching(*bounds);
+  const gfx::Rect work_area = display.work_area();
+  const gfx::Rect persona_area = EffectiveWorkArea(work_area);
+  if (*show_state == ui::mojom::WindowShowState::kMaximized &&
+      persona_area != work_area) {
+    *show_state = ui::mojom::WindowShowState::kNormal;
+    *bounds = persona_area;
+    return;
+  }
+  if (!bounds->IsEmpty() && !persona_area.Contains(*bounds))
+    bounds->AdjustToFit(persona_area);
+}
