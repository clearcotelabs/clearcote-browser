+    // Without this the same physical pixel lands on two different absolute y values and the two
+    // exits of one drawing buffer disagree.
+    const int64_t cc_abs_y = srcY + (bottom_up ? (h - 1 - y) : y);
+    uint8_t* row = reinterpret_cast<uint8_t*>(pbase + static_cast<size_t>(y) * fRowBytes);
+    for (int px = 0; px < w; ++px) {
+      const int64_t cc_abs_x = srcX + px;
+      uint8_t* p = row + static_cast<size_t>(px) * bpp;
+
+      uint64_t k = effective_seed;
+      k ^= static_cast<uint64_t>(cc_abs_x) * 0x9E3779B97F4A7C15ULL;
+      k = (k ^ (k >> 29)) * 0xBF58476D1CE4E5B9ULL;
+      k ^= static_cast<uint64_t>(cc_abs_y) * 0xC2B2AE3D27D4EB4FULL;
+      k = (k ^ (k >> 32)) * 0x94D049BB133111EBULL;
+      for (size_t c = 0; c < bpp && c < 3; ++c) {
+        k ^= static_cast<uint64_t>(p[c]) << (8 * c);
+      }
+      k = (k ^ (k >> 31)) * 0xD6E8FEB86659FD93ULL;
+      k ^= k >> 32;
+
+      if ((k % kDensity) != 0) {
+        continue;
+      }
+      // Alpha is never touched -- a changed alpha is visible, not sub-perceptual.
+      if (bpp >= 3) {
+        p[0] ^= static_cast<uint8_t>((k >> 40) & 1u);
+        p[1] ^= static_cast<uint8_t>((k >> 41) & 1u);
+        p[2] ^= static_cast<uint8_t>((k >> 42) & 1u);
+      } else {
+        p[0] ^= static_cast<uint8_t>((k >> 40) & 1u);
+      }
     }
   }
 }
