# Clearcote reference build configuration — Linux x64, built natively on Linux.
#
# This is the effective build configuration used to produce the published Linux pre-release
# (v0.1.0-pre.25, Chromium 151). It is config/args.gn with the target flipped to Linux: target_os="linux",
# use_sysroot=true (build against Chromium's bundled Debian bullseye sysroot -> glibc 2.31 floor),
# and the Windows-only cross flags (rust_sysroot_absolute, dawn_use_built_dxc) dropped. The de-Google
# set is identical to the Windows build; the release config differs only where Linux needs it
# (its own PGO profile, CFI off, mold off, the HLSL translator on, NaCl off).
# scripts/04-configure-build.sh copies this to out/Default/args.gn when TARGET=linux. (The build host
# also sets cc_wrapper="ccache", a compile cache that does not change the output.)

# --- De-Google (from ungoogled-chromium's flags.gn; kept explicit so this file is self-contained) ---
clang_use_chrome_plugins = false
disable_fieldtrial_testing_config = true
enable_hangout_services_extension = false
# On since Chromium 150 (the tree the binaries ship from). Which WebRTC candidates exist is decided
# by 100-webrtc-leak, so this build still shows no .local host candidates.
enable_mdns = true
enable_remoting = false
enable_reporting = false
enable_service_discovery = false
# Widevine EME *plumbing* only — clearcote does NOT bundle Google's proprietary CDM blob; the SDK
# fetches it opt-in at runtime (Linux uses the CDM hint file, see sdk/python/clearcote/_widevine.py).
enable_widevine = true
exclude_unwind_tables = true
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""
safe_browsing_mode = 0
use_official_google_api_keys = false
use_unofficial_version_number = false

# --- Target + toolchain (Linux x64, native) ---
target_os = "linux"
target_cpu = "x64"
is_clang = true
clang_base_path = "//third_party/llvm-build/Release+Asserts"
use_sysroot = true                    # Chromium's bundled amd64 bullseye sysroot -> glibc 2.31 floor
use_mold = false                      # link with lld, as the Windows build does

# --- Release configuration (official since Chromium 151; see config/args.gn) ---
is_debug = false
is_official_build = true              # ThinLTO + PGO, DCHECKs compiled out
dcheck_always_on = false              # explicit: the official default, kept visible
# CFI defaults ON for linux + x64 + official. It aborts the process on any indirect-call type
# mismatch, which a bindings-heavy patch stack invites; Windows official builds do not enable it.
is_cfi = false
use_cfi_icall = false
is_component_build = false            # single, shippable binary
symbol_level = 0
blink_symbol_level = 0
# PGO with Chromium's own Linux profile for this revision; it ships in the source tarball, so no
# download step is needed on Linux.
chrome_pgo_phase = 2
pgo_data_path = "//chrome/build/pgo_profiles/chrome-linux-7922-1785927076-bb17492c37d005d5bd31464529a7c78d371e030c-fe1da440d678744723d81cc39d45fc5ba3ccfa2d.profdata"
use_remoteexec = false
# ANGLE's HLSL translator, normally Windows-only. 966-angle-hlsl-dialect-optin needs it on Linux to
# report the HLSL dialect a Windows persona's D3D11 renderer implies (opt-in at runtime).
angle_enable_hlsl = true

# --- Media / codecs (match a normal desktop browser) ---
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# --- Build hygiene ---
enable_nacl = false
treat_warnings_as_errors = false
fatal_linker_warnings = false
v8_drumbrake_bounds_checks = true
